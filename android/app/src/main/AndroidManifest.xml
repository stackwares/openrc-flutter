<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- PostHog starts from Dart, and only when the build has a project token. -->
        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- Widget receivers -->
        <receiver
            android:name=".widgets.TransactionsSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_transactions_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/transactions_widget_small_info" />
        </receiver>

        <receiver
            android:name=".widgets.TransactionsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_transactions_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/transactions_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.TransactionsLargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_transactions_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/transactions_widget_large_info" />
        </receiver>

        <receiver
            android:name=".widgets.RevenueInsightsSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_insights_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/revenue_insights_widget_small_info" />
        </receiver>

        <receiver
            android:name=".widgets.RevenueInsightsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_insights_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/revenue_insights_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.RevenueInsightsLargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_insights_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/revenue_insights_widget_large_info" />
        </receiver>

        <receiver
            android:name=".widgets.RevenueTabSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_revenue_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/revenue_tab_widget_small_info" />
        </receiver>

        <receiver
            android:name=".widgets.RevenueTabWidgetProvider"
            android:exported="true"
            android:label="@string/widget_revenue_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/revenue_tab_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.RevenueTabLargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_revenue_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/revenue_tab_widget_large_info" />
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
