                    <TextView android:id="@+id/tvAppRevenue4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$5,627" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widgetTextPrimary" android:fontFamily="@font/sfns_black" android:includeFontPadding="false" />
                    <TextView android:id="@+id/tvAppPct4" android:layout_width="28dp" android:layout_height="wrap_content" android:text="45%" android:textSize="11sp" android:gravity="end" android:layout_marginStart="5dp" android:textColor="@color/widgetTextSecondary" android:fontFamily="@font/sfns_medium" android:includeFontPadding="false" />
                </LinearLayout>
<LinearLayout android:id="@+id/rowApp5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tvAppRank5" android:layout_width="18dp" android:layout_height="wrap_content" android:text="5" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widgetAccent" android:fontFamily="@font/sfns_black" android:includeFontPadding="false" />
