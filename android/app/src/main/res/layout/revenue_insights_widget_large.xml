                    android:textSize="12sp"
                    android:textColor="@color/widgetTextPrimary"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/tvCountryRevenue1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$4,744"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widgetTextPrimary"
                    android:fontFamily="sans-serif-black" />
                <TextView
                    android:id="@+id/tvCountryPct1"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="38%"
                    android:textSize="10sp"
                    android:textColor="@color/widgetTextSecondary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:id="@+id/rowCountry2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvCountryRank2"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/appleBlue"
                    android:fontFamily="sans-serif-black" />
                <TextView
