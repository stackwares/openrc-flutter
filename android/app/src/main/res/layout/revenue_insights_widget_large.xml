                    <TextView android:id="@+id/tvCountryRank5" android:layout_width="18dp" android:layout_height="wrap_content" android:text="5" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/appleBlue" android:fontFamily="@font/sfns_black" android:includeFontPadding="false" />
