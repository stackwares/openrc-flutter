                    android:gravity="end" />
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:id="@+id/rowCountry3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvCountryRank3"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/appleBlue"
                    android:fontFamily="sans-serif-black" />
                <TextView
                    android:id="@+id/tvCountryName3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🇩🇪 Germany"
                    android:textSize="12sp"
                    android:textColor="@color/widgetTextPrimary"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/tvCountryRevenue3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$1,594"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widgetTextPrimary"
                    android:fontFamily="sans-serif-black" />
                <TextView
                    android:id="@+id/tvCountryPct3"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="13%"
                    android:textSize="10sp"
                    android:textColor="@color/widgetTextSecondary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Row 4 -->
            <LinearLayout
                android:id="@+id/rowCountry4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvCountryRank4"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/appleBlue"
                    android:fontFamily="sans-serif-black" />
                <TextView
                    android:id="@+id/tvCountryName4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="12sp"
