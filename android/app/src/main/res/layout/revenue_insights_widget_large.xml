                    <TextView android:id="@+id/tvCountryRevenue1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$5,627" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widgetTextPrimary" android:fontFamily="@font/sfns_black" android:includeFontPadding="false" />
                    <TextView android:id="@+id/tvCountryPct1" android:layout_width="28dp" android:layout_height="wrap_content" android:text="45%" android:textSize="11sp" android:gravity="end" android:layout_marginStart="5dp" android:textColor="@color/widgetTextSecondary" android:fontFamily="@font/sfns_medium" android:includeFontPadding="false" />
