                    <TextView android:id="@+id/tvAppPct5" android:layout_width="28dp" android:layout_height="wrap_content" android:text="45%" android:textSize="11sp" android:gravity="end" android:layout_marginStart="5dp" android:textColor="@color/widgetTextSecondary" android:fontFamily="@font/sfns_medium" android:includeFontPadding="false" />
                </LinearLayout>
            <TextView
                android:id="@+id/tvTopAppsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="No data"
                android:textColor="@color/widgetTextQuaternary"
                android:textSize="13sp"
                android:fontFamily="@font/sfns_medium"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/widgetDivider"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOP COUNTRIES" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widgetTextSecondary" android:fontFamily="@font/sfns_medium" android:includeFontPadding="false" />
            <LinearLayout android:id="@+id/rowCountry1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tvCountryRank1" android:layout_width="18dp" android:layout_height="wrap_content" android:text="1" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/appleBlue" android:fontFamily="@font/sfns_black" android:includeFontPadding="false" />
