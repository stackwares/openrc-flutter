                    <TextView android:id="@+id/tvCountryPct3" android:layout_width="28dp" android:layout_height="wrap_content" android:text="45%" android:textSize="11sp" android:gravity="end" android:layout_marginStart="5dp" android:textColor="@color/widgetTextSecondary" android:fontFamily="@font/sfns_medium" android:includeFontPadding="false" />
