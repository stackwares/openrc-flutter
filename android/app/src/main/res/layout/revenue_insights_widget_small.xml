<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/widgetBackground">

    <!-- Header -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥧"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLATFORM"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widgetTextSecondary"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Platform bar -->
    <ImageView
        android:id="@+id/imgPlatformBar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:scaleType="fitXY" />

    <!-- Platform labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_circle_apple" />
            <TextView
                android:id="@+id/tvAppleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apple 65%"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="3dp" />
        </LinearLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_circle_google" />
            <TextView
                android:id="@+id/tvGoogleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google 35%"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="3dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- New vs Renewal header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW VS RENEWAL"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widgetTextSecondary"
        android:fontFamily="sans-serif-medium" />

    <!-- New vs Renewal bar -->
    <ImageView
        android:id="@+id/imgNewRenewalBar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitXY" />

    <!-- New vs Renewal labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_circle_new" />
            <TextView
                android:id="@+id/tvNewLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New 28%"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="3dp" />
        </LinearLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_circle_renewal" />
            <TextView
                android:id="@+id/tvRenewLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Renew 72%"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="3dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>