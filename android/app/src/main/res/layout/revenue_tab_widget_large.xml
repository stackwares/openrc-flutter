<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@color/widgetBackground">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰"
            android:textSize="18sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REVENUE DASHBOARD"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widgetTextSecondary"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/tvLastUpdated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2m ago"
            android:textSize="10sp"
            android:textColor="@color/widgetTextQuaternary"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- MTD Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_mtd_card"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/tvMtdRevenue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$12,451"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="@color/widgetTextPrimary"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tvMtdLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This month · local"
            android:textSize="12sp"
            android:textColor="@color/widgetTextSecondary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Period cards row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_period_card_large_today">
            <TextView
                android:id="@+id/tvToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$951"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widgetAccent"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_period_card_large_yesterday"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/tvYesterday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$850"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextPrimary"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yesterday"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_period_card_large_7days"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/tvLast7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$5.2K"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/appleBlue"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 Days"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_period_card_large_30days"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/tvLast30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$18.5K"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/renewalPurple"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 Days"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widgetDivider"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Platform + New vs Renewal row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Platform -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLATFORM"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium" />
            <ImageView
                android:id="@+id/imgPlatformBar"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:scaleType="fitXY" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_circle_apple" />
                    <TextView
                        android:id="@+id/tvAppleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apple 65%"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widgetTextSecondary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_circle_google" />
                    <TextView
                        android:id="@+id/tvGoogleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Google 35%"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widgetTextSecondary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widgetDivider"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <!-- New vs Renewal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEW VS RENEWAL"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widgetTextSecondary"
                android:fontFamily="sans-serif-medium" />
            <ImageView
                android:id="@+id/imgNewRenewalBar"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:scaleType="fitXY" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_circle_new" />
                    <TextView
                        android:id="@+id/tvNewLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New 28%"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widgetTextSecondary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_circle_renewal" />
                    <TextView
                        android:id="@+id/tvRenewLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Renew 72%"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widgetTextSecondary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>