rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App user profile (SteinAI-style); client may read/write own doc only.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Push tokens are written only by Cloud Functions (Admin SDK).
    match /pushUsers/{userId}/tokens/{tokenId} {
      allow read, write: if false;
    }
    match /webhookDedupe/{eventId} {
      allow read, write: if false;
    }
  }
}
