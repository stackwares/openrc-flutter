# Copy to .dev.vars for `npm run dev`. A Firebase service account key with
# permission to send Cloud Messaging messages, as one line of JSON.
FCM_SERVICE_ACCOUNT={"project_id":"your-project","client_email":"notifier@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
