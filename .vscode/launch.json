{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // Each config passes exactly one define file: dart_defines/openrc.debug.json
    // (development) or dart_defines/openrc.release.json (store values). Both are
    // local and gitignored and carry the Firebase and PostHog defines together.
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug",
            "request": "launch",
            "type": "dart",
            "toolArgs": ["--dart-define-from-file=dart_defines/openrc.debug.json"]
        },
        {
            "name": "Release",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": ["--dart-define-from-file=dart_defines/openrc.release.json"]
        },
        {
            // Dev tool. Start the relay first: cd relay && npm run dev
            "name": "Web (local relay)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "toolArgs": [
                "--dart-define-from-file=dart_defines/openrc.debug.json",
                "--dart-define=OPENRC_RELAY_URL=http://127.0.0.1:8787"
            ]
        },
        {
            "name": "ADB For Release",
            "request": "launch",
            "type": "node-terminal",
            "command": "adb devices && adb logcat -c && adb shell monkey -p ${input:androidPackageName} 1 && exec adb logcat -v time",
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "androidPackageName",
            "type": "promptString",
            "description": "Android package name to launch",
            "default": "com.openrc.app"
        }
    ]
}
