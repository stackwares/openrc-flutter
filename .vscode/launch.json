{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "Release",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            // Start the relay first: cd relay && npm run dev
            "name": "Web (local relay)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": ["--dart-define=OPENRC_RELAY_URL=http://127.0.0.1:8787"]
        },
        {
            "name": "ADB For Release",
            "request": "launch",
            "type": "node-terminal",
            "command": "adb devices && adb logcat -c && adb shell monkey -p ${input:androidPackageName} 1 && exec adb logcat -v time",
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "androidPackageName",
            "type": "promptString",
            "description": "Android package name to launch",
            "default": "com.openrc.app"
        }
    ]
}
